rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. 사용자 프로필 문서: users/{userId}
    match /users/{userId} {
      // 읽기: 누구나 가능 (공개 프로필 열람)
      allow read: if true;
      // 쓰기(생성/수정/삭제): 본인 UID와 일치할 때만 허용
      allow write: if request.auth != null && request.auth.uid == userId;

      // 2. 사용자 링크 컬렉션: users/{userId}/links/{linkId}
      match /links/{linkId} {
        // 읽기: 누구나 가능 (링크 모음 공개 열람)
        allow read: if true;
        // 쓰기(추가/수정/삭제): 로그인한 본인만 가능
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 그 외 정의되지 않은 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
